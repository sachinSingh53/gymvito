{
  "expo": {
    "name": "GymVito",
    "slug": "gymvito",
    "scheme": "gymvito",
    "owner": "sachin_53",
    "version": "1.0.0",
    "platforms": ["android", "ios"],
    "orientation": "default",
    "icon": "./assets/images/gymvito-app-icon.png",
    "userInterfaceStyle": "automatic",
    "android": {
      "package": "com.gymvito.app",
      "allowBackup": false,
      "blockedPermissions": [
        "android.permission.READ_EXTERNAL_STORAGE",
        "android.permission.WRITE_EXTERNAL_STORAGE"
      ],
      "adaptiveIcon": {
        "backgroundColor": "#071A18",
        "foregroundImage": "./assets/images/gymvito-mark.png",
        "monochromeImage": "./assets/images/gymvito-mark.png"
      },
      "predictiveBackGestureEnabled": false
    },
    "ios": {
      "bundleIdentifier": "com.gymvito.app",
      "supportsTablet": true,
      "icon": "./assets/expo.icon"
    },
    "plugins": [
      "expo-router",
      "expo-localization",
      "expo-secure-store",
      [
        "expo-image-picker",
        {
          "cameraPermission": "Allow $(PRODUCT_NAME) to use the camera to take member profile photos. Photos stay on this device.",
          "photosPermission": false,
          "microphonePermission": false
        }
      ],
      [
        "@react-native-community/datetimepicker",
        {
          "android": {
            "datePicker": {
              "colorAccent": {
                "light": "#0d6659"
              },
              "colorControlActivated": {
                "light": "#0d6659"
              },
              "colorControlHighlight": {
                "light": "#d4eee7"
              },
              "textColorPrimary": {
                "light": "#162d29"
              },
              "textColorSecondary": {
                "light": "#526963"
              },
              "textColorPrimaryInverse": {
                "light": "#ffffff"
              },
              "textColorSecondaryInverse": {
                "light": "#c9f2e8"
              }
            }
          }
        }
      ],
      [
        "expo-build-properties",
        {
          "android": {
            "minSdkVersion": 28,
            "compileSdkVersion": 36,
            "targetSdkVersion": 36,
            "buildToolsVersion": "36.0.0"
          }
        }
      ],
      [
        "expo-sqlite",
        {
          "useSQLCipher": true,
          "enableFTS": false
        }
      ],
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#071A18",
          "image": "./assets/images/gymvito-mark.png",
          "imageWidth": 156
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    },
    "extra": {
      "environment": "development",
      "developmentRuntime": "expo-go",
      "runtimeBackend": "none",
      "router": {},
      "eas": {
        "projectId": "8e0a98d9-0004-460c-9c15-cb8a3bc3c10f"
      }
    }
  }
}
