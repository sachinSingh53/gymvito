{
  "name": "gymvito",
  "version": "0.0.1",
  "private": true,
  "description": "Local-first encrypted gym membership manager",
  "main": "expo-router/entry",
  "packageManager": "pnpm@10.21.0",
  "engines": {
    "node": "22.23.1"
  },
  "scripts": {
    "start": "expo start --go",
    "start:dev-client": "expo start --dev-client",
    "android": "expo run:android",
    "android:device": "expo run:android --device",
    "eas:login": "EAS_NO_VCS=1 pnpm dlx eas-cli@latest login",
    "eas:init": "EAS_NO_VCS=1 pnpm dlx eas-cli@latest init",
    "eas:whoami": "EAS_NO_VCS=1 pnpm dlx eas-cli@latest whoami",
    "build:android:development": "EAS_NO_VCS=1 pnpm dlx eas-cli@latest build --platform android --profile development",
    "build:android:preview": "EAS_NO_VCS=1 pnpm dlx eas-cli@latest build --platform android --profile preview",
    "prebuild": "expo prebuild --platform android --clean",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "lint": "expo lint && pnpm lint:network && pnpm lint:architecture",
    "lint:network": "node scripts/check-network-boundary.mjs",
    "lint:architecture": "node scripts/check-architecture-boundaries.mjs",
    "typecheck": "tsc --noEmit",
    "test": "jest",
    "test:ci": "jest --runInBand --coverage",
    "test:date": "jest src/domain/dates --runInBand",
    "validate:migrations": "node scripts/validate-migrations.mjs",
    "validate:translations": "node scripts/validate-translations.mjs",
    "validate:phase2": "node scripts/benchmark-phase2-members.mjs",
    "validate:eas": "node scripts/validate-eas-profiles.mjs",
    "scan:fixtures": "node scripts/check-sensitive-fixtures.mjs",
    "validate": "pnpm format:check && pnpm lint && pnpm typecheck && pnpm validate:migrations && pnpm validate:translations && pnpm validate:phase2 && pnpm validate:eas && pnpm scan:fixtures && pnpm test:ci && pnpm expo:doctor",
    "expo:doctor": "expo-doctor",
    "prepare": "husky"
  },
  "dependencies": {
    "@expo-google-fonts/inter": "0.4.2",
    "@expo-google-fonts/material-symbols": "0.4.48",
    "@expo-google-fonts/noto-sans-devanagari": "0.4.1",
    "@noble/hashes": "2.0.1",
    "expo": "~57.0.27",
    "expo-asset": "~57.0.19",
    "expo-build-properties": "~57.0.22",
    "expo-constants": "~57.0.21",
    "expo-crypto": "~57.0.3",
    "expo-dev-client": "~57.0.19",
    "expo-document-picker": "~57.0.3",
    "expo-file-system": "~57.0.7",
    "expo-font": "~57.0.4",
    "expo-image-manipulator": "~57.0.21",
    "expo-linking": "~57.0.12",
    "expo-local-authentication": "~57.0.3",
    "expo-localization": "~57.0.2",
    "expo-print": "~57.0.2",
    "expo-router": "~57.0.25",
    "expo-screen-capture": "~57.0.4",
    "expo-secure-store": "~57.0.4",
    "expo-sharing": "~57.0.22",
    "expo-splash-screen": "~57.0.9",
    "expo-sqlite": "~57.0.4",
    "expo-status-bar": "~57.0.1",
    "expo-system-ui": "~57.0.4",
    "i18next": "^25.6.0",
    "react": "19.2.3",
    "react-i18next": "^16.2.1",
    "react-native": "0.86.3",
    "react-native-argon2": "4.0.0",
    "react-native-gesture-handler": "~2.32.0",
    "react-native-reanimated": "4.5.1",
    "react-native-safe-area-context": "~5.7.0",
    "react-native-screens": "~4.26.0",
    "react-native-worklets": "0.10.1"
  },
  "devDependencies": {
    "@react-native/metro-config": "0.86.3",
    "@testing-library/react-native": "13.3.3",
    "@types/jest": "29.5.14",
    "@types/node": "22.19.3",
    "@types/react": "~19.2.2",
    "eslint": "9.39.1",
    "eslint-config-expo": "~57.0.2",
    "expo-doctor": "1.20.4",
    "husky": "9.1.7",
    "jest": "29.7.0",
    "jest-expo": "~57.0.5",
    "lint-staged": "16.2.7",
    "prettier": "3.9.0",
    "react-test-renderer": "19.2.3",
    "typescript": "~6.0.3"
  },
  "lint-staged": {
    "*.{js,mjs,ts,tsx,json,md,yml,yaml}": "prettier --write",
    "*.{js,mjs,ts,tsx}": "eslint --fix"
  }
}
